{
  "index_name": "pln3-index",
  "cloud": "aws",
  "region": "us-east-1",
  "namespace": "v2-200tok",
  "eval_namespace": "eval-metrics",
  "model_name": "sentence-transformers/all-MiniLM-L6-v2",
  "ce_model": "cross-encoder/ms-marco-MiniLM-L-6-v2",
  "max_tokens_chunk": 200,
  "overlap": 60,
  "corpus_dir": "corpus",
  "summary_model": "gpt-4o",
  "summary_temperature": 0.3,
  "summary_max_tokens": 1000,
  "request_timeout": 60,
  "upsert_batch_size": 100,
  "index_ready_timeout": 120,
  "top_retrieve": 30,
  "top_final": 5,
  "per_doc_cap": 2,
  "metric": "cosine",
  "eval_ks": [5, 10],
  "eval_top_final": 10
}
